<TrammingSettings>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(6)

    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        row_default_height: dp(34)
        row_force_default: True
        spacing: dp(6)

        Label:
            text: tr._('Min position (%s):') % root.axis
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        TextInput:
            multiline: False
            input_type: 'number'
            input_filter: 'float'
            hint_text: tr._('machine coord')
            text: root.get_setting('min') if root.axis else ''
            on_text: root.setting_changed('min', self.text)

        Label:
            text: tr._('Max position (%s):') % root.axis
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        TextInput:
            multiline: False
            input_type: 'number'
            input_filter: 'float'
            hint_text: tr._('machine coord')
            text: root.get_setting('max') if root.axis else ''
            on_text: root.setting_changed('max', self.text)

        Label:
            text: tr._('Feed rate:')
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        TextInput:
            multiline: False
            input_type: 'number'
            input_filter: 'float'
            hint_text: tr._('500')
            text: root.get_setting('feed') if root.axis else ''
            on_text: root.setting_changed('feed', self.text)

        Label:
            text: tr._('Max loops (0 = until Stop):')
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        TextInput:
            multiline: False
            input_type: 'number'
            input_filter: 'int'
            hint_text: tr._('0')
            text: root.get_setting('loops') if root.axis else ''
            on_text: root.setting_changed('loops', self.text)

    Widget:
