#:import tr carveracontroller.__main__.tr
#:import ADJUST_MIN carveracontroller.addons.camera.CameraView.ADJUST_MIN
#:import ADJUST_MAX carveracontroller.addons.camera.CameraView.ADJUST_MAX
#:import ADJUST_DEFAULT carveracontroller.addons.camera.CameraView.ADJUST_DEFAULT
#:import RESOLUTION_LABELS carveracontroller.addons.camera.Z1Camera.RESOLUTION_LABELS
#:import RESOLUTION_CHOICES carveracontroller.addons.camera.Z1Camera.RESOLUTION_CHOICES

<CameraButtonSlot@AnchorLayout>:
    visible: False
    anchor_x: 'right'
    anchor_y: 'top'
    size_hint_y: None
    height: '50dp' if self.visible else 0
    opacity: 1 if self.visible else 0

<CameraAdjustPanel@BoxLayout>:
    visible: False
    orientation: 'vertical'
    size_hint_y: None
    height: '200dp' if self.visible else 0
    opacity: 1 if self.visible else 0
    padding: '8dp'
    spacing: '4dp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.6
        Rectangle:
            pos: self.pos
            size: self.size

<CameraAdjustRow@BoxLayout>:
    label_text: ''
    value: ADJUST_DEFAULT
    Label:
        text: root.label_text
        size_hint_x: 0.42
        font_size: '13sp'
    Slider:
        min: ADJUST_MIN
        max: ADJUST_MAX
        value: root.value
        on_value: root.value = self.value

<CameraJogPanel@BoxLayout>:
    visible: False
    orientation: 'horizontal'
    size_hint: None, None
    width: '196dp'
    height: '124dp' if self.visible else 0
    opacity: 1 if self.visible else 0
    disabled: not self.visible or not (app.state == 'Idle' or app.state == 'Run' or app.state == 'Pause') or (app.playing and app.state != 'Pause') or (app.state == 'Run' and app.root.allow_jogging_while_machine_running == '0')
    padding: '6dp'
    spacing: '6dp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.6
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10),]
    GridLayout:
        # Same arrangement as the Control page so muscle memory carries over.
        cols: 3
        rows: 3
        spacing: '3dp'
        Widget:
        SmallRoundButton:
            text: 'Y+' if app.invert_y_axis_jogging else 'Y-'
            on_press: app.root.controller.jog("Y{}{}".format('' if app.invert_y_axis_jogging else '-', step_xy.text))
            on_release: app.root.controller.stopContinuousJog()
        Widget:
        SmallRoundButton:
            text: 'X-'
            on_press: app.root.controller.jog("X-{}".format(step_xy.text))
            on_release: app.root.controller.stopContinuousJog()
        Spinner:
            id: step_xy
            font_size: '13sp'
            text: '1'
            values: '10', '1', '0.1', '0.01', '0.005'
            disabled: app.jog_mode_text == tr._('Jog Mode:Continuous')
        SmallRoundButton:
            text: 'X+'
            on_press: app.root.controller.jog("X{}".format(step_xy.text))
            on_release: app.root.controller.stopContinuousJog()
        Widget:
        SmallRoundButton:
            text: 'Y-' if app.invert_y_axis_jogging else 'Y+'
            on_press: app.root.controller.jog("Y{}{}".format('-' if app.invert_y_axis_jogging else '', step_xy.text))
            on_release: app.root.controller.stopContinuousJog()
        Widget:
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: '46dp'
        spacing: '3dp'
        SmallRoundButton:
            text: 'Z+'
            on_press: app.root.controller.jog("Z{}".format(step_z.text))
            on_release: app.root.controller.stopContinuousJog()
        Spinner:
            id: step_z
            font_size: '13sp'
            text: '1'
            values: '10', '1', '0.1', '0.01', '0.005'
            disabled: app.jog_mode_text == tr._('Jog Mode:Continuous')
        SmallRoundButton:
            text: 'Z-'
            on_press: app.root.controller.jog("Z-{}".format(step_z.text))
            on_release: app.root.controller.stopContinuousJog()

<CameraControls@BoxLayout>:
    adjust_open: False
    jog_open: False
    orientation: 'vertical'
    size_hint: None, None
    width: '250dp'
    height: self.minimum_height
    CameraButtonSlot:
        visible: app.supports_camera
        TransparentButton:
            icon: 'data/camera.png'
            active: app.camera_streaming
            size_hint: None, None
            width: '50dp'
            height: self.parent.height
            on_release:
                app.root.toggle_camera_stream()
    CameraButtonSlot:
        visible: app.camera_streaming
        TransparentButton:
            icon: 'data/configure.png'
            active: root.adjust_open
            size_hint: None, None
            width: '50dp'
            height: self.parent.height
            on_release:
                root.adjust_open = not root.adjust_open
    CameraButtonSlot:
        visible: app.camera_streaming
        TransparentButton:
            icon: 'data/move.png'
            active: root.jog_open
            size_hint: None, None
            width: '50dp'
            height: self.parent.height
            on_release:
                root.jog_open = not root.jog_open
    CameraAdjustPanel:
        visible: root.adjust_open and app.camera_streaming
        BoxLayout:
            Label:
                text: tr._('Resolution')
                size_hint_x: 0.42
                font_size: '13sp'
            Spinner:
                text: RESOLUTION_LABELS[app.camera_resolution]
                values: RESOLUTION_CHOICES
                on_text:
                    app.root.set_camera_resolution(self.text)
        CameraAdjustRow:
            label_text: tr._('Brightness')
            value: app.camera_brightness
            on_value: app.camera_brightness = self.value
        CameraAdjustRow:
            label_text: tr._('Contrast')
            value: app.camera_contrast
            on_value: app.camera_contrast = self.value
        CameraAdjustRow:
            label_text: tr._('Gamma')
            value: app.camera_gamma
            on_value: app.camera_gamma = self.value
        Button:
            text: tr._('Reset')
            on_release:
                app.camera_brightness = ADJUST_DEFAULT
                app.camera_contrast = ADJUST_DEFAULT
                app.camera_gamma = ADJUST_DEFAULT
